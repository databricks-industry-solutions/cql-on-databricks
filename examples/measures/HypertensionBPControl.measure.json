  "version": "1.0.0",
  "name": "HypertensionBPControl",
  "title": "Hypertension: blood pressure below 140/90 (sample)",
  "status": "active",
  "experimental": true,
  "publisher": "CQL on Databricks examples",
  "description": "Adults 18 to 85 with hypertension whose most recent blood pressure in the measurement period is below 140/90 mmHg. A sample measure, written for this repository; not a published measure.",
  "rationale": "Controlling high blood pressure lowers the risk of heart attack, stroke and kidney disease.",
  "guidance": "The hypertension diagnosis must start on or before June 30 of the measurement period. Patients in hospice or palliative care, with end-stage kidney disease, dialysis or a kidney transplant, or pregnant during the period are excluded. A patient with no reading in the period is not in the numerator.",
