  "version": "1.0.0",
  "name": "DiabetesHighOrMissingA1c",
  "title": "Diabetes: HbA1c above 9% or missing (sample)",
  "status": "active",
  "experimental": true,
  "publisher": "CQL on Databricks examples",
  "description": "Adults 18 to 75 with diabetes whose most recent HbA1c in the measurement period is above 9%, has no result, or who had no HbA1c test in the period. A sample measure, written for this repository; not a published measure.",
  "rationale": "Poorly controlled blood sugar raises the risk of diabetes complications, and a missing test is a gap in care.",
  "guidance": "An inverse measure: a lower rate is better. A test with no result, or no test in the period, counts as poor control. Patients in hospice or palliative care are excluded.",
  "library": [
    "http://example.org/fhir/Library/DiabetesHighOrMissingA1c"
  ],
