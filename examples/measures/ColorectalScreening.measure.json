  "version": "1.0.0",
  "name": "ColorectalScreening",
  "title": "Adults 45 to 75 current on colorectal cancer screening (sample)",
  "status": "active",
  "experimental": true,
  "publisher": "CQL on Databricks examples",
  "description": "Adults 45 to 75 who are current on colorectal cancer screening. A sample measure, written for this repository; not a published measure.",
  "rationale": "Screening finds colorectal cancer early, when it is easier to treat, and can prevent it by removing polyps.",
  "guidance": "Each test has its own lookback, ending at the end of the measurement period: a colonoscopy in the period or the nine years before, a flexible sigmoidoscopy or CT colonography in the period or the four years before, a stool DNA test in the period or the two years before, or a fecal immunochemical test in the period. Patients in hospice or palliative care, with colorectal cancer, or after a total colectomy are excluded.",
