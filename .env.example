# .env.example — TEMPLATE for the OPTIONAL root .env: LOCAL-RUN settings and secrets only.
#
# WORKSPACE settings do NOT go here (SVC-LOCAL-CONFIG-BUNDLE). The workspace host, CLI profile,
# catalogs and warehouse live ONLY in databricks.local.yml — the file deploys read too —
# and local runs take them from there. A .env that sets any of these is REFUSED:
#   DATABRICKS_HOST  DATABRICKS_CONFIG_PROFILE  UC_CATALOG  CONTENT_CATALOG  CQL_RUNTIME_CATALOG
#   CQL_DESIGNER_RESULTS_CATALOG  WAREHOUSE_ID  CQL_ASSISTANT_ENDPOINT
#
# Read by run-app.sh, setup.sh, scripts/with-local-env.sh and the backend's __main__, AFTER the
# workspace settings are exported, so ${UC_CATALOG} below resolves. Deploy scripts never read it.
#
# SETUP:
#   1. cp databricks.local.yml.example databricks.local.yml   (workspace settings — required)
#   2. cp .env.example .env   (local-run settings; without it local runs use OSS Spark, not serverless)

# ── Compute ─────────────────────────────────────────────────────────────────
# Route local runs at Databricks serverless (databricks-connect) instead of OSS Spark Connect.
DATABRICKS_SERVERLESS=1

# ── Content-ingest (CONTENT-INGEST) ─────────────────────────────────────────
# Run it as: scripts/with-local-env.sh python -m content_ingest ecqi <package>
#
# Your own UMLS API key (https://uts.nlm.nih.gov/uts/), for the VSAC expansions of an imported eCQI package.
# Required unless the import passes --no-valuesets.
# UMLS_API_KEY=

# ── CQL on Databricks backend (SVC-RUN-DBCONNECT) ──────────────────────────────────────
# Materialize retrieves as their own scan barriers (RUN-SCAN-BARRIER) — one Job task and one
# content-addressed `scan_<type>_<hash8>` table per filtered retrieve, instead of the retrieve being
# inlined at each use site. Sent to the engine as `materialize.retrieves` in CompileRequest.overrides.
#   none   (default) every retrieve inlined — the engine's own default, byte-identical plans
#   costly a filtered scan reused at >= materialize.retrieve_min_reuse (default 2) call sites.
#          Counts OCCURRENCES and declines most scans within ONE measure — the fleet setting.
#   all    every filtered scan — the diagnosis setting. A BARE retrieve is never materialized
#          under any value (DATA-SKIP-UNFILTERED).
# LOCAL DEV ONLY. A materialized scan is a table whose SQL never changes, so RUN-NOTHING-TO-DO finds
# it current forever and serves results computed against data that has moved; enabling it in a
# deployment is blocked on RUN-FINGERPRINT's data term (execution-architecture.md section 13 item 5).
# Requires a Compiler Service built from an engine that has the retrieve-barrier API — an older one
# accepts the override and silently ignores it.
# CQL_MATERIALIZE_RETRIEVES=all

# ── Compiler Service (SVC-COMPILE-ENDPOINT) ─────────────────────────────────
# Local dev defaults to http://127.0.0.1:8080. On Databricks, App-to-App OAuth replaces this.
# CQL_COMPILER_ENDPOINT=http://127.0.0.1:8080
# CQL_COMPILER_TOKEN=

# ── OSS Spark Connect (only when NOT using databricks-connect above) ────────
# CQL_DATABRICKS_CONNECT=sc://localhost:15002
